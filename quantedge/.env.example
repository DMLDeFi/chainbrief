# ---- copy to .env and fill in; never commit .env ----
QE_DATABASE_URL=postgresql+psycopg://quantedge:change-me@db:5432/quantedge
QE_AUTH_SECRET=            # python -c "import secrets;print(secrets.token_urlsafe(48))"
QE_ADMIN_USERNAME=admin
QE_ADMIN_PASSWORD_HASH=    # python -m quantedge hash-password
QE_START_ENGINE=true
QE_PAPER_TRADING=true      # keep true until the deployment gate passes

# Bybit: a read-only key is enough in signal mode (fee-tier lookup). Never enable Withdraw.
QE_BYBIT_API_KEY=
QE_BYBIT_API_SECRET=
QE_BYBIT_TESTNET=false

# Telegram Bot API
QE_NOTIFY__TELEGRAM_ENABLED=false
QE_NOTIFY__TELEGRAM_BOT_TOKEN=
QE_NOTIFY__TELEGRAM_CHAT_IDS=          # comma separated
QE_NOTIFY__TELEGRAM_ADMIN_IDS=         # chats allowed to send /halt, /resume ...

# WhatsApp Cloud API (templates quantedge_signal / quantedge_update / quantedge_report must be approved)
QE_NOTIFY__WHATSAPP_ENABLED=false
QE_NOTIFY__WHATSAPP_TOKEN=
QE_NOTIFY__WHATSAPP_PHONE_NUMBER_ID=
QE_NOTIFY__WHATSAPP_RECIPIENTS=        # E.164 numbers without '+', comma separated
QE_NOTIFY__WHATSAPP_APP_SECRET=        # verifies webhook signatures
QE_NOTIFY__WHATSAPP_VERIFY_TOKEN=

# Optional AI explanations (advisory only, never affects decisions)
QE_ANTHROPIC_API_KEY=

# Automated execution stays OFF until validated and approved by an admin in the dashboard
QE_EXECUTION__ENABLED=false
QE_EXECUTION__TESTNET=true
