# ---------------- Game server (apps/server) ----------------
PORT=4000
# One in-game hour per TICK_MS milliseconds (a day = 24 ticks).
TICK_MS=2000
WORLD_SEED=20260101
# Leave empty to use the zero-setup JSON store in DATA_DIR.
# With docker compose:  postgresql://mon:mon@localhost:5432/merchants
DATABASE_URL=
DATA_DIR=./data
ALLOW_FAST_FORWARD=true
MAX_FAST_FORWARD_DAYS=14
COOKIE_SECURE=false

# Optional: Claude voices merchants in character (deterministic replies otherwise).
# Get a key at https://console.anthropic.com — never commit it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# NEAR (testnet). The game is fully playable without these.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Account the contract is deployed to (scripts/deploy-contract.sh).
NEAR_CONTRACT_ID=
# 32-byte hex seed from `npm run keygen`. Signs ownership certificates; it is not a NEAR account key.
GAME_AUTHORITY_SECRET=
NEAR_SIGN_RECIPIENT=merchants-of-near

# ---------------- Web (apps/web) ----------------
# Where Next.js proxies /api requests.
API_ORIGIN=http://localhost:4000
# WebSocket endpoint for the live world stream (defaults to <host>:4000/ws).
NEXT_PUBLIC_WS_URL=
